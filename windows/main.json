{
  "layout": "stack",
  "regions": [
    {
      "id": "status",
      "widgets": [
        { "type": "markdown", "value": "## Git & GitHub CLI" },
        {
          "type": "auth_status",
          "bind": "GET /api/apps/git/status",
          "logout_action": { "call": "POST /api/apps/git/logout" },
          "loading_text": "Checking GitHub login…",
          "logged_in_text": "Logged in as {username}"
        }
      ]
    },
    {
      "id": "device-login",
      "widgets": [
        { "type": "markdown", "hide_when_logged_in": true, "value": "### Sign in with GitHub\nClick to get a one-time code, then open [github.com/login/device](https://github.com/login/device) and enter it there — login is detected automatically, no need to click anything else." },
        {
          "type": "button",
          "hide_when_logged_in": true,
          "label": "Sign in with GitHub",
          "action": {
            "call": "POST /api/apps/git/device/start",
            "poll": {
              "call": "POST /api/apps/git/device/poll",
              "interval_ms": 3000,
              "timeout_ms": 900000,
              "done_field": "status",
              "done_values": ["success", "expired_token", "access_denied", "error"],
              "pending_text": "Waiting for authorization on [github.com/login/device](https://github.com/login/device)…",
              "timeout_text": "Timed out waiting for authorization — click Sign in with GitHub again."
            }
          }
        }
      ]
    },
    {
      "id": "advanced",
      "widgets": [
        {
          "type": "collapsible",
          "title": "Advanced / token login",
          "collapsed": true,
          "widgets": [
            { "type": "markdown", "value": "Only needed for a token login, your own OAuth App, or setting the git commit identity." },
            {
              "type": "form",
              "id": "advanced_settings",
              "submit": { "call": "POST /api/apps/git/settings" },
              "submit_label": "Save",
              "fields": [
                {
                  "key": "github_token",
                  "label": "GitHub personal access token",
                  "input": "password",
                  "placeholder": "ghp_…",
                  "description": "Paste a token to sign in without the device-flow button above. Scopes: repo, read:org. Stored in the zero-knowledge secret store, never in plain config."
                },
                {
                  "key": "git_user_name",
                  "label": "Git user.name",
                  "input": "text",
                  "placeholder": "Jane Doe"
                },
                {
                  "key": "git_user_email",
                  "label": "Git user.email",
                  "input": "text",
                  "placeholder": "jane@example.com"
                },
                {
                  "key": "oauth_client_id",
                  "label": "OAuth App client_id (custom)",
                  "input": "text",
                  "placeholder": "Ov23liWR67ZgY2P6fYKh (default, already configured)",
                  "description": "Only set this if you want to use your own GitHub OAuth App for the Sign in with GitHub button instead of aw-app-git's public one."
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
