{
  "layout": "stack",
  "regions": [
    {
      "id": "status",
      "widgets": [
        { "type": "markdown", "text": "## Git & GitHub CLI" },
        { "type": "text", "id": "gh_status", "bind": "GET /api/apps/git/status" }
      ]
    },
    {
      "id": "device-login",
      "widgets": [
        { "type": "markdown", "value": "### Sign in with GitHub\nClick to get a one-time code, then open github.com/login/device and enter it there — login is detected automatically, no need to click anything else." },
        {
          "type": "button",
          "label": "Sign in with GitHub",
          "action": {
            "call": "POST /api/apps/git/device/start",
            "poll": {
              "call": "POST /api/apps/git/device/poll",
              "interval_ms": 3000,
              "timeout_ms": 900000,
              "done_field": "status",
              "done_values": ["success", "expired_token", "access_denied", "error"],
              "pending_text": "Waiting for authorization on github.com/login/device…",
              "timeout_text": "Timed out waiting for authorization — click Sign in with GitHub again."
            }
          }
        }
      ]
    },
    {
      "id": "login",
      "widgets": [
        { "type": "markdown", "value": "### Alternative: paste a token\nOnly needed if the OAuth Device Flow above isn't configured." },
        { "type": "form", "id": "login_form", "fields": ["auth_method", "github_token"] },
        { "type": "button", "label": "Log in", "action": { "call": "POST /api/apps/git/login" } }
      ]
    }
  ]
}
