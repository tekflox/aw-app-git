{
  "manifest_version": 1,
  "id": "git",
  "name": "Git + GitHub CLI",
  "version": "0.1.0",
  "description": "Installs git and the GitHub CLI (gh) into the workspace, survives restarts, and provides a settings panel for gh login (token stored in the zero-knowledge secret store).",
  "tier": "inprocess",

  "runtime": {
    "python": ">=3.11",
    "entrypoint": "git_app.plugin:GitAppPlugin",
    "pip_requires": []
  },

  "permissions": [
    "commands:install",
    "routes:register",
    "secrets:own",
    "fs:workspace-data",
    "net:outbound"
  ],

  "contributes": {
    "routes": [{ "prefix": "/api/apps/git" }],
    "system_clis": [
      { "name": "git", "installer": "scripts/install_git.sh", "version": ">=2.30" },
      { "name": "gh", "installer": "scripts/install_gh.sh", "version": ">=2.40" }
    ],
    "windows": [
      { "id": "git.main", "title": "Git & GitHub CLI",
        "body": { "type": "declarative", "spec": "windows/main.json" } }
    ],
    "nav": [
      { "id": "git.nav", "label": "Git", "icon": "git-branch", "opens": "git.main" }
    ],
    "settings_panels": [
      { "id": "git.settings", "schema_ref": "#/config_schema" }
    ]
  },

  "config_schema": {
    "type": "object",
    "properties": {
      "auth_method": {
        "type": "string",
        "enum": ["token", "web"],
        "default": "token",
        "description": "How to log into gh: paste a personal access token, or run the interactive `gh auth login` web flow."
      },
      "github_token": {
        "type": "string",
        "x-secret": true,
        "description": "GitHub personal access token (scopes: repo, read:org). Used for `gh auth login --with-token` when auth_method=token. Never stored in plain config — routed to the zero-knowledge secret store."
      },
      "git_user_name": { "type": "string", "description": "git config --global user.name" },
      "git_user_email": { "type": "string", "description": "git config --global user.email" }
    },
    "required": []
  },

  "dependencies": {},

  "migrations": {}
}
